page {
  font-size: 28rpx;
  background: #e3f5eb;
  --td-brand-color: #00b26a;
  --td-brand-color-light: #e0f2ec;
  --td-button-light-active-bg-color: #c4dcd4;
  --td-primary-color-8: #008550;
}

/* 卡片通用样式 */
.card-style {
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.1);
  background: #fff;
}

page {
  --primary-color: #00b26a;
  --primary-color-rgb: 0, 178, 106;
  --secondary-color: #f0faf5;
  --card-shadow: 0 8rpx 40rpx rgba(0,0,0,0.1);
  /* 文字色阶变量 - 统一使用 */
  --text-primary: #2d3436;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --text-disabled: #cccccc;
}

/* ========== P0: 全局交互反馈 ========== */

/* 通用点击反馈 - 触按即响应 */
.press-fade:active {
  opacity: 0.7;
  transition: opacity 80ms ease-out;
}

.press-scale:active {
  transform: scale(0.97);
  transition: transform 80ms ease-out;
}

.press-bg:active {
  background: rgba(0, 0, 0, 0.05) !important;
  transition: background 80ms ease-out;
}

/* 自定义导航栏反馈 */
.nav-header:active {
  opacity: 0.8;
  transition: opacity 80ms ease-out;
}

/* ========== P2: 页面入场动画 ========== */

/* 为 navigateTo 的子页面容器添加入场动画 */
@keyframes pageIn {
  from {
    opacity: 0;
    transform: translateX(30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ========== P3: 减少动效降级 ========== */
@media (prefers-reduced-motion: reduce) {
  /* 关闭所有非必要的循环动画 */
  .weather-card,
  .custom-notice,
  .notice-new-dot {
    animation: none !important;
  }

  /* 卡片入场/出场用纯 opacity fade */
  .todo-item.add-animation {
    animation: fadeIn 0.2s ease forwards !important;
  }

  .todo-item.remove-animation {
    animation: fadeOut 0.2s ease forwards !important;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* ========== P3: 降低透明度降级 ========== */
@media (prefers-reduced-transparency: reduce) {
  /* 顶部导航栏实色后备 */
  .top {
    background: #e3f5eb !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  /* 所有弹窗内容区实色后备 */
  .invite-popup,
  .approval-popup,
  .login-popup,
  .copy-popup,
  .share-popup,
  .comment-popup,
  .visitor-popup,
  .combo-popup-content {
    background: #ffffff !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border: 1rpx solid #e0e0e0 !important;
  }

  /* 公告栏实色后备 */
  .custom-notice {
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  /* 评论输入栏（浮动层）实色后备 */
  .comment-input-bar {
    background: #ffffff !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }
}