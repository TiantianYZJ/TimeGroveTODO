.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 10rpx;
  flex-shrink: 0;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d3436;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 10rpx 16rpx;
  flex-shrink: 0;
}

.action-bar .search-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(245, 245, 245, 0.85);
  backdrop-filter: blur(16rpx) saturate(180%);
  -webkit-backdrop-filter: blur(16rpx) saturate(180%);
  border-radius: 40rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
}

.action-bar .search-row .search-input {
  flex: 1;
  font-size: 26rpx;
  height: 36rpx;
  color: #1a1a1a;
}
.action-bar .search-row .search-input::placeholder { color: #bbb; }

.search-clear {
  padding: 4rpx;
  display: flex;
  align-items: center;
}

.batch-remove-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx;
  background: #fff;
  border: 2rpx solid #ff4757;
  border-radius: 40rpx;
  color: #ff4757;
  font-size: 24rpx;
  white-space: nowrap;
  flex-shrink: 0;
  transition: transform 100ms ease-out, background 200ms ease;
}

.batch-remove-btn:active {
  background: #fff5f5;
  transform: scale(0.96);
}

/* 列表 */
.list-scroll {
  flex: 1;
  overflow-y: auto;
}

.admin-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.admin-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(12rpx) saturate(180%);
  -webkit-backdrop-filter: blur(12rpx) saturate(180%);
  border-radius: 24rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  transition: transform 100ms ease-out, background 200ms ease, border-color 200ms ease;
}

.admin-card:active {
  transform: scale(0.98);
  background: rgba(245, 245, 248, 0.92);
}

.admin-card.selected {
  background: rgba(235, 248, 240, 0.95);
}

.sel-bar {
  width: 6rpx;
  height: 40rpx;
  border-radius: 3rpx;
  background: #00b26a;
  flex-shrink: 0;
}

.admin-card.batch-mode {
  padding-left: 12rpx;
}

.admin-checkbox {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 100ms ease-out;
}
.admin-checkbox:active {
  transform: scale(0.85);
}

.admin-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.admin-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d3436;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-date {
  font-size: 22rpx;
  color: #999;
}

.admin-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.admin-remove-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: transform 100ms ease-out, background 200ms ease;
}

.admin-remove-btn:active {
  background: rgba(255, 71, 87, 0.1);
  transform: scale(0.9);
}

/* Loading & Empty & No-More */
.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 添加/搜索弹窗 */
.popup-content {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 24rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.popup-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: transform 100ms ease-out, background 200ms ease;
}
.popup-close:active {
  background: rgba(0,0,0,0.05);
  transform: scale(0.88);
}

.popup-body {
  flex: 1;
  overflow-y: auto;
}

.popup-search-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: rgba(245, 245, 245, 0.85);
  backdrop-filter: blur(16rpx) saturate(180%);
  -webkit-backdrop-filter: blur(16rpx) saturate(180%);
  border-radius: 40rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.popup-search-row .search-input {
  flex: 1;
  font-size: 28rpx;
  height: 40rpx;
  color: #1a1a1a;
}
.popup-search-row .search-input::placeholder { color: #bbb; }

.popup-search-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 28rpx;
  background: #00b26a;
  color: #fff;
  font-size: 26rpx;
  border-radius: 40rpx;
  border: none;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1;
  height: auto;
}
.popup-search-btn::after { border: none; }
.popup-search-btn { transition: transform 100ms ease-out, opacity 200ms ease; }
.popup-search-btn:active { transform: scale(0.96); opacity: 0.8; }

/* 搜索结果 */
.search-results {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.user-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: rgba(248, 249, 250, 0.8);
  border-radius: 20rpx;
  transition: transform 100ms ease-out, background 200ms ease;
}

.user-item:active {
  transform: scale(0.98);
  background: rgba(227, 245, 235, 0.8);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.user-name {
  font-size: 28rpx;
  color: #2d3436;
  font-weight: 500;
}

.user-id {
  font-size: 22rpx;
  color: #999;
}

.user-add-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
}
.user-add-btn:active {
  background: rgba(0, 178, 106, 0.1);
}

.search-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 批量选择模式提示 */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  margin: 0 10rpx 12rpx;
  background: rgba(227, 245, 235, 0.7);
  backdrop-filter: blur(12rpx) saturate(180%);
  -webkit-backdrop-filter: blur(12rpx) saturate(180%);
  border-radius: 20rpx;
  flex-shrink: 0;
}

.batch-bar .batch-count {
  font-size: 26rpx;
  color: #00b26a;
  font-weight: 500;
}

.batch-bar .batch-cancel {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  transition: transform 100ms ease-out, background 200ms ease;
}
.batch-bar .batch-cancel:active {
  background: rgba(0,0,0,0.05);
  transform: scale(0.96);
}

