.scroll-area {
  height: 100vh;
}

.container {
  padding: 0 32rpx 160rpx;
}

.section-list {
  padding: 20rpx 0;
}

.t-tabs {
  --td-tab-nav-bg-color: #e3f5eb;
  --td-tab-item-disabled-color: #fff;
  --td-tab-item-height: 64rpx;
}

/* 模板项 — 对标 report-edit 绿色色点 + 输入框 */
.template-item {
  margin-bottom: 32rpx;
}

.template-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 32rpx;
  position: relative;
  margin-bottom: 12rpx;
}

.template-item-header::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #00b26a;
  border-radius: 50%;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.delete-icon {
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 输入框 — gray background, no card */
.item-input {
  background: #f8f8f8 !important;
  border-radius: 32rpx !important;
  padding: 24rpx !important;
  font-size: 28rpx !important;
  color: #333 !important;
}

.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #ccc;
}

.add-section-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 16rpx 0 40rpx;
  padding: 24rpx 0;
  border: 2rpx dashed #00b26a;
  border-radius: 32rpx;
  background: #fafff5;
}

.add-text {
  font-size: 32rpx;
  color: #00b26a;
  font-weight: 500;
}

.bottom-safe {
  height: 160rpx;
}

/* ========== 汇报到选择器 ========== */
.form-item {
  padding-bottom: 16rpx;
}

.question-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.1;
  color: #333;
  margin-bottom: 15rpx;
  padding-left: 32rpx;
  position: relative;
}

.question-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #00b26a;
  border-radius: 50%;
}

.combo-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  margin-left: 24rpx;
  background: #f8f8f8;
  border-radius: 32rpx;
}

.selected-combo {
  flex: 1;
}

.combo-name-text {
  font-size: 30rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 组合选择 Popup ========== */
.combo-picker-content {
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.popup-close {
  padding: 8rpx;
}

.popup-scroll {
  flex: 1;
  padding: 20rpx 32rpx;
  max-height: 60vh;
  box-sizing: border-box;
  overflow-x: hidden;
}

.picker-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.picker-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
  gap: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
  transition: all 0.2s ease;
}

.picker-option:active {
  transform: scale(0.98);
}

.picker-option.selected {
  background: #e3f5eb;
}

.option-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  overflow: hidden;
}

.option-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-combos {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
