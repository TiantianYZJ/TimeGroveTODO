<scroll-view class="scroll-area" scroll-y>

  <view class="container">

    <!-- 修改目标选择器 -->
    <view class="form-item">
      <text class="question-title">修改目标</text>
      <view class="combo-selector" bindtap="showComboPicker">
        <view class="selected-combo">
          <text class="combo-name-text">{{comboName}}</text>
        </view>
        <t-icon name="chevron-down" size="32rpx" color="#ccc" />
      </view>
    </view>

    <t-tabs value="{{currentType}}" bind:change="onTypeChange">
      <t-tab-panel label="日报模板" value="daily">
        <view class="section-list">
          <view class="template-item" wx:for="{{dailySections}}" wx:key="key" data-index="{{index}}">
            <view class="template-item-header">
              <text class="item-title">段落名称</text>
              <view class="delete-icon" data-type="daily" data-index="{{index}}" bindtap="deleteSection">
                <t-icon name="delete" size="32rpx" color="#ff4d4f" />
              </view>
            </view>
            <t-input
              class="item-input"
              value="{{item.title}}"
              placeholder="输入段落名称"
              data-type="daily"
              data-index="{{index}}"
              bind:change="onSectionTitleInput"
            />
          </view>
          <view wx:if="{{dailySections.length === 0}}" class="empty-hint">
            <text>暂无日报段落，点击下方添加</text>
          </view>
        </view>
        <view class="add-section-btn" data-type="daily" bindtap="addSection">
          <t-icon name="add" size="36rpx" color="#00b26a" />
          <text class="add-text">添加新段落</text>
        </view>
      </t-tab-panel>
      <t-tab-panel label="周报模板" value="weekly">
        <view class="section-list">
          <view class="template-item" wx:for="{{weeklySections}}" wx:key="key" data-index="{{index}}">
            <view class="template-item-header">
              <text class="item-title">段落名称</text>
              <view class="delete-icon" data-type="weekly" data-index="{{index}}" bindtap="deleteSection">
                <t-icon name="delete" size="32rpx" color="#ff4d4f" />
              </view>
            </view>
            <t-input
              class="item-input"
              value="{{item.title}}"
              placeholder="输入段落名称"
              data-type="weekly"
              data-index="{{index}}"
              bind:change="onSectionTitleInput"
            />
          </view>
          <view wx:if="{{weeklySections.length === 0}}" class="empty-hint">
            <text>暂无周报段落，点击下方添加</text>
          </view>
        </view>
        <view class="add-section-btn" data-type="weekly" bindtap="addSection">
          <t-icon name="add" size="36rpx" color="#00b26a" />
          <text class="add-text">添加新段落</text>
        </view>
      </t-tab-panel>
    </t-tabs>

    <view class="bottom-safe"></view>
  </view>
</scroll-view>

<!-- 组合选择 Popup -->
<t-popup
  visible="{{showComboPicker}}"
  bind:visible-change="onComboPickerVisibleChange"
  placement="bottom"
  close-on-overlay-click="{{true}}"
  z-index="11000"
  overlay-props="{{ { zIndex: 10999 } }}"
>
  <view class="combo-picker-content">
    <view class="popup-header">
      <text class="popup-title">选择修改目标</text>
      <view class="popup-close" bindtap="hideComboPicker">
        <t-icon name="close" size="40rpx" color="#999" />
      </view>
    </view>

    <scroll-view class="popup-scroll" scroll-y>
      <!-- 私人 -->
      <view class="picker-section">
        <text class="section-label">私人</text>
        <view
          class="picker-option {{comboId === 0 ? 'selected' : ''}}"
          bindtap="selectPrivateCombo"
        >
          <view class="option-icon" style="background: #00b26a">
            <t-icon name="lock-on" size="36rpx" color="#fff" />
          </view>
          <view class="option-info">
            <text class="option-name">不绑定组合</text>
            <text class="option-desc">仅自己可见，不归属任何组合</text>
          </view>
          <t-icon wx:if="{{comboId === 0}}" name="check" size="36rpx" color="#00b26a" />
        </view>
      </view>

      <!-- 共享组合 -->
      <view wx:if="{{sharedCombos.length > 0}}" class="picker-section">
        <text class="section-label">共享组合</text>
        <view
          class="picker-option {{comboId === item.id ? 'selected' : ''}}"
          wx:for="{{sharedCombos}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="selectCombo"
        >
          <view class="option-icon" style="background: {{item.color || '#2196F3'}}">
            <t-icon name="{{item.icon || 'user-group'}}" size="36rpx" color="#fff" />
          </view>
          <view class="option-info">
            <text class="option-name">{{item.name}}</text>
            <text class="option-desc">{{item.todoCount || 0}}个待办 · {{item.memberCount || 1}}人</text>
          </view>
          <t-icon wx:if="{{comboId === item.id}}" name="check" size="36rpx" color="#00b26a" />
        </view>
      </view>

      <view wx:if="{{sharedCombos.length === 0}}" class="empty-combos">
        <text>暂无共享组合</text>
      </view>
    </scroll-view>
  </view>
</t-popup>

<t-fab icon="check" text="完成" bind:click="saveTemplates" style="right: 32rpx; bottom: 32rpx;" />
