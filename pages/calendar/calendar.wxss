/* 头部区域 */
.header {
  padding: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
}

/* 标题样式 */
.title {
  font-size: 50rpx;
  font-weight: 600;
  color: #2d3436;
  flex: 1;
}

/* 日历容器 - 与todo页面内容区域对齐 */
.calendar-container {
  margin-top: 170rpx;
}

.todo-list {
}

.todo-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 550;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  display: block;
}

.no-todo-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.no-todo-text {
  color: var(--td-text-color-placeholder, #999);
  font-size: 28rpx;
  text-align: center;
  padding: 40rpx 0;
}

/* 广告容器样式 */
.ad-container {
  margin: 20rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.ad-container ad-custom {
  width: 100%;
  display: block;
}

/* 报告列表样式 */
.report-list {
  padding: 0 20rpx 30rpx;
}

.report-item-wrapper {
  position: relative;
  margin-top: 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  transition: all 0.3s ease;
}

.t-tabs {
  --td-tab-nav-bg-color: #e3f5eb;
  --td-tab-item-height: 64rpx;
}

.tab-content {
}

/* ========== Todo 卡片样式（从 todo.wxss inline，因去除 @import 后丢失） ========== */
.todo-item {
  margin: 12rpx 20rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.5s ease,
    background-color 0.5s ease;
  position: relative;
  display: flex;
  overflow: hidden;
}

.todo-item.completed {
  background: linear-gradient(135deg, #ecfdf5 0%, #90e0b7 100%) !important;
  box-shadow: 0 4rpx 16rpx rgba(76,175,80,0.15);
}

.todo-item.completed .t-cell__title {
  color: #00b26a !important;
  text-decoration: line-through;
}

.todo-item.completed .t-cell__description {
  color: #6b7280 !important;
  opacity: 0.7;
}

.todo-item.completed .t-cell__note {
  color: #9ca3af !important;
}

.todo-item:active {
  animation: cardPulse 0.3s ease;
}

@keyframes cardPulse {
  0% {
    box-shadow:
      0 4rpx 8rpx rgba(0,0,0,0.1),
      0 0 0 0 rgba(45, 212, 191, 0);
  }
  50% {
    box-shadow:
      0 4rpx 8rpx rgba(0,0,0,0.1),
      0 0 0 12rpx rgba(45, 212, 191, 0.2);
  }
  100% {
    box-shadow:
      0 4rpx 8rpx rgba(0,0,0,0.1),
      0 0 0 24rpx rgba(45, 212, 191, 0);
  }
}

/* 收藏角标 */
.star-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx;
  border-radius: 0 0 30rpx 0;
  font-weight: 600;
  z-index: 10;
  animation: badgeBounce 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes badgeBounce {
  0% {
    transform: scale(0) rotate(-15deg);
    opacity: 0;
  }
  50% {
    transform: scale(1.1) rotate(5deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

/* 卡片进入动画 */
@keyframes slideInUp {
  0% {
    transform: translateY(40rpx) scale(0.95);
    opacity: 0;
  }
  60% {
    transform: translateY(-8rpx) scale(1.02);
    opacity: 1;
  }
  100% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

.todo-item.add-animation {
  animation: slideInUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* t-cell 样式 */
.t-cell {
  min-height: 100rpx !important;
  padding: 20rpx 30rpx !important;
  width: 720rpx !important;
  box-sizing: border-box;
  transition:
    transform 0.4s cubic-bezier(0.23, 1, 0.32, 1),
    box-shadow 0.4s ease,
    background-color 0.3s ease;
}

.t-cell__title {
  flex: 1;
  min-width: 465rpx;
  max-width: 465rpx;
  margin-right: 10rpx !important;
  transform: translateY(10%);
  font-size: 34rpx !important;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.t-cell__description {
  flex: 1;
  max-width: 420rpx;
  margin-right: 10rpx !important;
  transform: translateY(-25%);
  font-size: 28rpx !important;
  display: -webkit-box;
  -webkit-box-orient: vertical;
}

.t-cell__note {
  flex-shrink: 0;
  font-size: 24rpx !important;
  color: #666 !important;
  margin-top: 8rpx !important;
}

.t-cell__right-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
}

.todo-item-wrapper {
  position: relative;
  margin-bottom: 0rpx;
  border-radius: 32rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* ========== 报告 tab 工具栏 ========== */
.report-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.report-toolbar-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 24rpx;
  background: #e3f5eb;
  border-radius: 32rpx;
}

.report-toolbar-action:active {
  opacity: 0.7;
}

.report-toolbar-text {
  font-size: 28rpx;
  color: #00b26a;
  font-weight: 500;
}
